# -----------------------------------------------------------------------------
# Brightloop Subscription Management System — Environment Configuration
# -----------------------------------------------------------------------------

PROJECT_NAME="Brightloop Subscription Management"
ENVIRONMENT="development"

# Security & JWT Auth
SECRET_KEY="insecure-change-in-production-brightloop-secret-key-32-chars-min"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL 18)
# For local Windows PostgreSQL 18 or Docker container
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="brightloop_subscriptions"
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/brightloop_subscriptions"
SYNC_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/brightloop_subscriptions"

# Organization Defaults
ORGANIZATION_CURRENCY="USD"
ORGANIZATION_TIMEZONE="UTC"

# Cache & Background Queue
REDIS_URL="redis://localhost:6379/0"

# Email Delivery (Local Mailpit SMTP)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_FROM="billing@brightloop.local"
FRONTEND_URL="http://localhost:5173"

# Frontend / CORS
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"
VITE_API_URL="http://localhost:8000"


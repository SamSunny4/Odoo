# =====================================================================
# Brightloop Subscription Management System — Production Environment Template
# Copy to .env.production and provide production credentials before launch.
# =====================================================================

ENVIRONMENT=production
DEBUG=false
PROJECT_NAME="Brightloop Subscription Management"
DOMAIN=billing.brightloop.com
ACME_EMAIL=ops@brightloop.com

# ---------------------------------------------------------------------
# Security & Secret Key
# Generate with: openssl rand -hex 32
# MUST BE AT LEAST 32 CHARACTERS IN PRODUCTION (enforced by startup validator)
# ---------------------------------------------------------------------
SECRET_KEY=replace-with-64-character-cryptographically-random-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SESSION_COOKIE_NAME=brightloop_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
TRUST_PROXY_HEADERS=true

# ---------------------------------------------------------------------
# PostgreSQL Database Configuration
# ---------------------------------------------------------------------
POSTGRES_USER=brightloop_admin
POSTGRES_PASSWORD=replace-with-secure-database-password
POSTGRES_DB=brightloop_production
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
SYNC_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# ---------------------------------------------------------------------
# Redis & Background Workers
# ---------------------------------------------------------------------
REDIS_PASSWORD=replace-with-secure-redis-password
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# ---------------------------------------------------------------------
# Email Delivery (Amazon SES, SendGrid, Mailgun, Postmark)
# ---------------------------------------------------------------------
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=replace-with-provider-smtp-api-key
SMTP_FROM=billing@brightloop.com

# ---------------------------------------------------------------------
# Organization & Application Settings
# ---------------------------------------------------------------------
ORGANIZATION_CURRENCY=INR
ORGANIZATION_TIMEZONE=UTC
FRONTEND_URL=https://billing.brightloop.com
CORS_ORIGINS=https://billing.brightloop.com

